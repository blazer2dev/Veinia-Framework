
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin veinia_defaults/arial_rounded.TTF
/copy:veinia_defaults/arial_rounded.TTF

#begin veinia_defaults/circle.png
/importer:TextureImporter
/processor:TextureProcessor
/build:veinia_defaults/circle.png

#begin veinia_defaults/square.png
/importer:TextureImporter
/processor:TextureProcessor
/build:veinia_defaults/square.png

#begin veinia_defaults/triangle.png
/importer:TextureImporter
/processor:TextureProcessor
/build:veinia_defaults/triangle.png

#begin DiagnosticsFont.xnb
/copy:DiagnosticsFont.xnb

#begin veinia_defaults/prefab_default.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255, 0, 255, 255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:veinia_defaults/prefab_default.png

#begin veinia_defaults/trail_default.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:veinia_defaults/trail_default.fx

